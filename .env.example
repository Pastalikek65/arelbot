TELEGRAM_TOKEN=your_telegram_bot_token_here
OWNER_ID=your_telegram_user_id_here
TELEGRAM_MODE=polling
# auto enables verified custom button icons; off keeps Unicode icons and colors.
TELEGRAM_CUSTOM_BUTTON_EMOJI=auto
APP_ROLE=combined
APP_ENV=development
# Set true in production to keep the Telegram operational topic error-only.
LOG_CHANNEL_ERRORS_ONLY=false
# External provider governance is enforced automatically when APP_ENV=production;
# keep this false only for local development/replay.
REQUIRE_PROVIDER_APPROVAL=false
BOT_PERSONA_ENABLED=true
BOT_SARCASM_LEVEL=2
AI_FAST_MAX_TOKENS=256
AI_TOOL_MAX_TOKENS=384
# DeepSeek V4 Flash: none disables the thinking pass for responsive chat.
AI_REASONING_EFFORT=none
AI_THINKING_ENABLED=false
WEBHOOK_URL=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_PATH=telegram/webhook
WEBHOOK_SECRET=
# Optional loopback health/Prometheus endpoint; keep disabled unless a local
# exporter or reverse proxy is configured. A public bind requires a token.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_LISTEN=127.0.0.1
OBSERVABILITY_PORT=9108
OBSERVABILITY_WORKER_PORT=9109
OBSERVABILITY_TOKEN=
OBSERVABILITY_TOKEN_FILE=
# Production host-side secret source for the Compose observability token.
# Keep the file outside the repository with 0600 permissions.
ARELBOT_OBSERVABILITY_TOKEN_FILE=
# Optional Grafana admin password file for the monitoring Compose profile.
# Production preflight requires this when MONITORING_ENABLED=true.
GRAFANA_ADMIN_PASSWORD_FILE=
# HTTPS webhook receiver used by Alertmanager for operational alerts. Keep the
# file outside the repository with 0600 permissions; monitoring preflight
# rejects HTTP, private hosts, credentials and query-string secrets.
ARELBOT_ALERT_WEBHOOK_URL_FILE=
MONITORING_ENABLED=false

# --- Encryption (for API key encryption) ---
# ENCRYPTION_KEY=your_encryption_key_here

# --- Optional Providers (not in the production default route) ---
IAMHC_URL=https://api.iamhc.cn/v1
IAMHC_KEY=sk-your_deepseek_api_key_here
IAMHC_MODEL=DeepSeek-V4-Flash

# --- EVREN (OpenAI-compatible DeepSeek V4 Flash) ---
# Keep the key only in the deployment secret store; never commit it.
EVREN_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_LLM_API_KEY=
EVREN_MODEL=deepseek-v4.1-flash

# --- Primary AI Provider ---
FREEMODEL_URL=https://api.freemodel.dev/v1
FREEMODEL_KEY=your_freemodel_api_key_here
FREEMODEL_MODEL=gpt-5.3-codex
AI_VISION_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_EMBEDDING_MODEL=
# Optional USD per 1M token estimates, JSON only (no keys or prompts).
AI_COST_RATES={}
# Optional task routing JSON; names: evren, nvidia, freemodel, groq, gemini, cerebras, iamhc, ninerouter.
AI_PROVIDER_ROUTES={"chat":["openai"],"fast":["openai"],"analysis":["openai"],"summary":["openai"],"sticker_tagging":["nvidia","evren"]}

# --- Kek Guardian moderation bridge (separate service, disabled by default) ---
GUARDIAN_MODE=disabled
GUARDIAN_SOCKET_PATH=/run/kek-guardian/guardian.sock
GUARDIAN_TIMEOUT_SECONDS=0.15
GUARDIAN_REQUIRE_PEER_CREDENTIALS=true
GUARDIAN_PEER_UIDS=
GUARDIAN_PEER_GIDS=

# --- NVIDIA NIM (optional OpenAI-compatible DeepSeek V4.1 Flash) ---
# Never commit this value. NVIDIA_API_KEY is read from the deployment secret store.
NVIDIA_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_VISION_MODEL=

# --- Arel Tahmin / akipy ---
AKINATOR_MAX_CONCURRENCY=4
AKINATOR_TIMEOUT_SECONDS=45
# Compose dev/prod profiles provide a private FlareSolverr service. Leave
# empty to use the Compose default; set an internal URL only for a separately
# managed solver. Never publish this endpoint to the Internet.
AKINATOR_SOLVER_URL=
AKINATOR_SOLVER_TIMEOUT_MS=120000
GUESS_AGE_ROUNDS=5
GUESS_AGE_ROUND_SECONDS=30
UNO_TURN_SECONDS=60
# The Mini App remains disabled until its HTTPS endpoint and initData
# validation are deployed. Telegram UNO works without these values.
MINIAPP_GAMES_ENABLED=false
MINIAPP_URL=
TTS_OUTPUT_DIR=downloads
TTS_MAX_CONCURRENCY=2
TTS_TIMEOUT_SECONDS=30
TTS_MAX_CHARS=1000
TTS_MAX_OUTPUT_BYTES=12582912
STICKER_TEMP_DIR=temp/stickers
STICKER_MAX_CONCURRENCY=2
STICKER_MAX_INPUT_BYTES=20971520
STICKER_RENDER_TIMEOUT_SECONDS=20
QUOTE_OUTPUT_DIR=downloads/quotes
QUOTE_MAX_CONCURRENCY=2
QUOTE_RENDER_TIMEOUT_SECONDS=15
QUOTE_MAX_MESSAGES=10
QUOTE_MAX_OUTPUT_BYTES=8388608

NINEROUTER_URL=https://rdi4qg6.9router.com/v1
NINEROUTER_KEY=sk-your_ninerouter_key_here
NINEROUTER_MODEL=areltest

# --- Other AI Services ---
# OpenAI can use the normal headless Codex CLI. The CLI reads the account login
# from OPENAI_CHATGPT_CODEX_HOST_DIR; never put tokens in this file.
OPENAI_CHATGPT_ENABLED=true
OPENAI_CHATGPT_MODE=cli
OPENAI_CHATGPT_MODEL=gpt-5.6-luna
OPENAI_CHATGPT_FALLBACK_MODEL=gpt-6-luna
OPENAI_CHATGPT_REASONING_EFFORT=none
OPENAI_CHATGPT_CLI_BIN=codex
OPENAI_CHATGPT_CLI_MODEL=
OPENAI_CHATGPT_CLI_WORKDIR=/tmp
OPENAI_CHATGPT_CODEX_HOME=/run/arel-openai/codex
OPENAI_CHATGPT_CODEX_HOST_DIR=/root/.codex
OPENAI_CHATGPT_CREDENTIALS_FILE=/run/arel-openai/credentials.json
OPENAI_CHATGPT_CREDENTIALS_HOST_DIR=./secrets/openai-chatgpt
OPENAI_CHATGPT_TIMEOUT_SECONDS=40
GEMINI_KEYS=key1,key2,key3
GROQ_KEYS=key1,key2,key3
GROQ_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Image Generation ---
IMAGEN_KEYS=key1,key2
NANOBANANA_KEYS=key1,key2
CLOUDFLARE_ACCOUNTS=account_id:token,account_id2:token2
CLOUDFLARE_CHAT_MODEL=@cf/openai/gpt-oss-120b
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# The configured route order is primary -> fallback; rotation is opt-in.
AI_ROTATION_ENABLED=false
AI_ROTATION_PRIMARY_COUNT=2
AI_ROUTER_TIMEOUT_SECONDS=40
AI_TEXT_PROVIDER_TIMEOUT_SECONDS=12

# --- Database ---
DATABASE_URL=mysql+pymysql://user:pass@localhost/db_name
# The Compose MongoDB and Redis services refuse anonymous access.  The
# password is interpolated into the connection string, so it must not
# contain a reserved URI character (`@`, `:`, `/`, `#`, `%`).
# The Compose service environment overrides the two values below, so keep
# their password in sync with MONGO_APP_PASSWORD and REDIS_PASSWORD.
# MONGO_ROOT_* is the administrative account.  It is used for the initial
# setup, the backup and the password rotation, never by the application.
MONGO_ROOT_USERNAME=areladmin
MONGO_ROOT_PASSWORD=replace-with-a-random-mongo-password
# MONGO_APP_* is the least-privilege account the application connects with.
# It may only read and write the `arel_bot` database.
MONGO_APP_USERNAME=arel_app
MONGO_APP_PASSWORD=replace-with-a-random-mongo-app-password
# MONGO_TEST_* is the account of the `test` Compose profile.  It is confined
# to the disposable test databases.
MONGO_TEST_USERNAME=arel_test
MONGO_TEST_PASSWORD=replace-with-a-random-mongo-test-password
REDIS_PASSWORD=replace-with-a-random-redis-password
# Optional host and database used when only the credentials are configured
# and the application has to build the connection string itself.
MONGODB_HOST=mongo:27017
MONGODB_DATABASE=arel_bot
MONGODB_URI=mongodb://arel_app:replace-with-a-random-mongo-app-password@localhost:27017/arel_bot?authSource=arel_bot
MONGODB_REQUIRED=false
REDIS_URL=redis://:replace-with-a-random-redis-password@localhost:6379/0
# Production bot/worker roles fail fast when shared Redis is unavailable.
REDIS_REQUIRED=false
CITY_DATA_PATH=src/data/turkish_cities.json
FEATURE_REGISTRY_ENABLED=true
# Optional JSON kill-switch map, e.g. {"weather": false, "get_weather": false}
FEATURE_FLAGS={}
# Optional comma-separated emergency disable list, e.g. weather,breaking_news
DISABLED_FEATURES=
# Optional validated staging-core profile. It is accepted only with
# APP_ENV=staging and adds its disabled provider list before startup.
STAGING_PROFILE_PATH=
# Typed provider'lar varsayilan uretim yoludur. Gecis sirasinda acikca etkinlestirilebilir.
LEGACY_PROVIDER_FALLBACK_ENABLED=false
# Empty means all registered tools are available to AI. Set a comma-separated allowlist in production.
# Virgulle ayrilmis AI araclari. Bos birakilirsa Config icindeki guvenli varsayilan liste kullanilir.
AI_TOOL_ALLOWLIST=
PRODUCTIVITY_MAX_NOTES=200
PRODUCTIVITY_MAX_TASKS=200

# --- Media pipeline ---
MEDIA_REDIS_REQUIRED=false
MEDIA_DOWNLOAD_DIR=downloads
MEDIA_MAX_FILE_BYTES=47185920
MAX_VIDEO_DURATION_SECONDS=0
MEDIA_QUEUE_WORKERS=4
# Hard cancellation ceiling; the 10-second completion SLO below is measured
# separately and does not cancel a slow but otherwise valid public job.
MEDIA_JOB_TIMEOUT_SECONDS=60
MEDIA_COMPLETION_SLO_SECONDS=10
# Use aria2c when available (Docker image includes it; Windows falls back to yt-dlp).
MEDIA_ARIA2_ENABLED=true
MEDIA_FALLBACK_URLS=
# Alias accepted for deployments that manage providers as individual settings.
# MEDIA_PROVIDER_FALLBACK_URLS=https://provider.example
RAG_MAX_FILE_BYTES=20971520
RAG_UPLOAD_DIR=downloads
RAG_USE_PROVIDER_EMBEDDINGS=false
DOCUMENT_QUEUE_WORKERS=2
DOCUMENT_JOB_TIMEOUT_SECONDS=120
DOCUMENT_REDIS_REQUIRED=false
ATTACHMENT_QUEUE_WORKERS=2
ATTACHMENT_JOB_TIMEOUT_SECONDS=120
ATTACHMENT_TEMP_DIR=temp/attachments
ATTACHMENT_MAX_FILE_BYTES=20971520
ATTACHMENT_REDIS_REQUIRED=false
QUOTE_QUEUE_WORKERS=2
QUOTE_JOB_TIMEOUT_SECONDS=120
SPEECH_QUEUE_WORKERS=2
SPEECH_JOB_TIMEOUT_SECONDS=120
STICKER_TAG_QUEUE_WORKERS=2
STICKER_TAG_JOB_TIMEOUT_SECONDS=120
STICKER_TAG_TEMP_DIR=temp/sticker_tags
MARKET_CHART_QUEUE_WORKERS=2
MARKET_CHART_JOB_TIMEOUT_SECONDS=30
NEWS_RSS_FEEDS=
# Optional CoinGecko Demo/Pro endpoint and key. Never commit the key.
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo
MEDIA_COOKIE_ENABLED=false
MEDIA_COOKIE_STORAGE_DIR=data/cookies
ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters

# --- Docker build TLS (optional, Windows/endpoint inspection only) ---
# PEM/DER root CA path passed as a BuildKit secret during image builds.
# Leave empty on a normal Linux VDS; production keeps certificate verification on.
ARELBOT_BUILD_CA_FILE=

# --- MCP Servers ---
# MCP_SERVERS={"server_name": {"command": "python", "args": ["-m", "server_module"]}}

# Optional private DeepSeek Web proxy. Account credentials live only in the sidecar.
D2API_ENABLED=false
D2API_URL=http://d2api:9655/v1
D2API_KEY=
D2API_MODEL=deepseek-v4.1-flash
## Optional HRMN gateway (credentials belong only in the private .env)
HRMN_API_KEY=
HRMN_URL=https://api.hrmn.tr/v1
