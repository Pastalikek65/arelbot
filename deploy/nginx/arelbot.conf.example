# Copy to /etc/nginx/sites-available/arelbot and replace the two placeholders.
# The bot container is bound to 127.0.0.1 by docker-compose; Telegram never
# reaches the Python process without TLS termination and the webhook secret.

upstream arelbot_bot {
    server 127.0.0.1:8443;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name BOT_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name BOT_DOMAIN;

    ssl_certificate /etc/letsencrypt/live/BOT_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/BOT_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:arelbot_tls:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Telegram sends only POST updates to this exact path. The Python
    # application validates X-Telegram-Bot-Api-Secret-Token itself.
    location = /telegram/webhook {
        proxy_pass http://arelbot_bot/telegram/webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
        proxy_read_timeout 75s;
        proxy_send_timeout 15s;
        proxy_buffering off;
        client_max_body_size 20m;
    }

    location / {
        return 404;
    }
}
