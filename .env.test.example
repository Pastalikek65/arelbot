# Synthetic environment of the Compose `test` profile.
#
# The Compose test service reads `.env.test` through `env_file: .env.test`,
# and `.env.test` is a copy of this example file, so the pytest container
# never receives the production `.env` with its live Telegram token, AI
# provider keys and encryption key.  The project `.env` stays the
# interpolation source of the Compose file; it is resolved by Compose itself
# and is not injected into the container.
#
# Every value below is a placeholder.  No real token, key or password
# belongs in this file.  Copy it to `.env.test` for a local Compose run;
# `.env.test` is ignored by Git and is never committed.
#
# The MongoDB and Redis passwords are interpolated by Compose into the
# connection strings without escaping, so they use the character set that
# `config.validate_database_password` enforces (A-Z a-z 0-9 - _ . ~).
TELEGRAM_TOKEN=123456:TESTtestTokenabcdefghijklmnop
MONGODB_URI=mongodb://arel_test:ci-mongo-test-pass@mongo:27017/arel_bot_test?authSource=arel_bot_test
REDIS_URL=redis://:ci-redis-pass@redis:6379/1
MONGO_ROOT_USERNAME=areladmin
MONGO_ROOT_PASSWORD=ci-mongo-pass
MONGO_APP_USERNAME=arel_app
MONGO_APP_PASSWORD=ci-mongo-app-pass
MONGO_TEST_USERNAME=arel_test
MONGO_TEST_PASSWORD=ci-mongo-test-pass
REDIS_PASSWORD=ci-redis-pass
APP_ROLE=combined
APP_ENV=test
OBSERVABILITY_ENABLED=false
MEDIA_REDIS_REQUIRED=false
MONGODB_REQUIRED=false
REDIS_REQUIRED=false
FREEMODEL_KEY=test-freemodel-key
GROQ_KEYS=test-groq-key
ENCRYPTION_KEY=test-encryption-key-0123456789abcdef0123456789abcdef
